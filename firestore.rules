rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // الأدمن = مستخدم مسجّل دخول وإله document باسم الـ UID تبعه في admins (بينضاف من الكونسول بس)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------- صلاحيات الأدمن ----------
    // admins/{uid}.perms = قائمة الأقسام المسموحة. أدمن بدون perms (القدام) = كل الصلاحيات.
    // صاحب المنصة (الإيميل تحت) عنده كل شي، وهو بس بيضيف المشرفين ويعدّل صلاحياتهم.
    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'habojarad305@gmail.com' && isAdmin();
    }
    function isFull() {
      return isOwner() || (isAdmin() && !('perms' in adminData()));
    }
    function can(p) {
      return isAdmin() && (isFull() || p in adminData().perms);
    }
    // محتوى الموقع صار 4 صلاحيات لحالها؛ 'site' القديمة لسا بتفتح الأربعة (للمشرفين اللي انضافوا قبل التقسيم)
    function canSite(p) {
      return can(p) || can('site');
    }
    function permKeys() {
      return ['members', 'team', 'forms', 'workshops', 'content', 'events', 'gallery', 'contact', 'blog', 'site', 'studio', 'stats', 'settings'];
    }

    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function registrationOpen() {
      let path = /databases/$(database)/documents/site/settings;
      return !exists(path) || get(path).data.get('registrationOpen', true) != false;
    }

    // ---------- التسجيلات ----------
    // الزوار: إضافة تسجيل صالح بس (ولما يكون التسجيل مفتوح).
    // الأدمن: قراءة، حذف، تعليم «تواصلنا»، ونقل لسلة المحذوفات (deletedAt) أو استرجاع منها.
    match /members/{memberId} {
      allow create: if registrationOpen() && isValidMember(request.resource.data);
      allow read, delete: if can('members');
      allow update: if can('members')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacted', 'deletedAt'])
        && request.resource.data.get('contacted', false) is bool
        && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == request.time);
    }

    // ---------- عدّاد الزيارات ----------
    // stats/{YYYY-MM-DD}: أرقام بس (home / join / start). الزائر بيقدر يزيد رقم واحد بـ 1 كل مرة، والأدمن بس بيقرأ.
    match /stats/{day} {
      allow read: if can('stats');
      allow create: if day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && request.resource.data.keys().hasOnly(['home', 'join', 'start'])
        && request.resource.data.size() == 1
        && request.resource.data.get('home', 1) == 1
        && request.resource.data.get('join', 1) == 1
        && request.resource.data.get('start', 1) == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['home', 'join', 'start'])
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && bumped('home') && bumped('join') && bumped('start');
    }

    function bumped(k) {
      return request.resource.data.get(k, 0) == resource.data.get(k, 0)
        || request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1;
    }

    function isValidMember(d) {
      return d.keys().hasAll(['name', 'whatsapp', 'status', 'specialty', 'age', 'residence', 'consent', 'createdAt'])
        && d.keys().hasOnly(['name', 'whatsapp', 'email', 'status', 'specialty', 'age', 'experience',
                             'residence', 'university', 'portfolio', 'notes', 'consent', 'source', 'createdAt'])
        && d.consent == true
        && d.whatsapp is string && d.whatsapp.matches('^\\+[1-9][0-9]{7,14}$')
        && (!('email' in d) || (isStr(d.email, 6, 120) && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')))
        && (!('portfolio' in d) || (isStr(d.portfolio, 10, 300) && d.portfolio.matches('^https?://[^\\s]+$')))
        && isStr(d.name, 2, 80)
        && d.status in ['tawjihi', 'student', 'graduate']
        // طالب التوجيهي ما إله جامعة ولا خبرة؛ الباقي لازم يبعتوهم
        && (d.status == 'tawjihi' || d.keys().hasAll(['experience', 'university']))
        && isStr(d.specialty, 2, 80)
        && d.age is int && d.age >= 14 && d.age <= 70
        && (!('experience' in d) || d.experience in ['none', 'lt1', '1-2', '3-5', '5+'])
        && isStr(d.residence, 2, 80)
        && (!('university' in d) || isStr(d.university, 2, 120))
        && (!('notes' in d) || isStr(d.notes, 0, 1000))
        && (!('source' in d) || d.source == 'web')
        && d.createdAt == request.time;
    }

    // ---------- محتوى الصفحة والإعدادات ----------
    // settings.currentWorkshop = رقم الورشة اللي بتطلع على /workshop
    match /site/{docId} {
      allow read: if docId in ['content', 'settings', 'forms'];
      allow write: if request.resource.size() < 200 * 1024 && (
        (docId == 'content' && canSite('content'))
        || (docId == 'forms' && can('forms'))
        || (docId == 'settings' && (isFull() || (isAdmin() && settingsKeys().hasOnly(allowedSettingsKeys())))));
    }
    function settingsKeys() {
      return resource == null ? request.resource.data.keys().toSet() : request.resource.data.diff(resource.data).affectedKeys();
    }
    function allowedSettingsKeys() {
      return ['updatedAt']
        .concat(can('settings') ? ['registrationOpen', 'closedMessage', 'whatsappGroup'] : [])
        .concat(can('team') ? ['showMembers'] : [])
        .concat(can('workshops') ? ['currentWorkshop', 'nextWorkshop'] : [])
        .concat(canSite('contact') ? ['contactWhatsapp', 'contactEmail', 'socialLinks'] : []);
    }

    // ---------- الورشات ----------
    // كل ورشة doc لحالها: المعلومات + المحاور + قالب الشهادة. status: draft (للأدمن بس) / live (منشورة) / done (انتهت، بالأرشيف).
    // publishAt (اختياري): ورشة «منشورة» بتضل مخفية وما بتقبل تسجيل لحد هاد الوقت (نشر مجدول).
    match /workshops/{wid} {
      allow read: if can('workshops') || resource.data.status == 'done'
        || (resource.data.status == 'live' && published(resource.data));
      allow create, update: if can('workshops')
        && request.resource.data.status in ['draft', 'live', 'done']
        && request.resource.data.open is bool
        && isStr(request.resource.data.title, 1, 60)
        && (request.resource.data.get('publishAt', null) == null || request.resource.data.publishAt is timestamp)
        && (request.resource.data.get('liveFrom', null) == null || request.resource.data.liveFrom is timestamp)
        && (request.resource.data.get('liveTo', null) == null || request.resource.data.liveTo is timestamp)
        && request.resource.size() < 400 * 1024;
      allow delete: if can('workshops');
    }

    // وصل موعد نشرها (أو ما إلها موعد)
    function published(w) {
      return w.get('publishAt', null) == null || request.time >= w.publishAt;
    }

    // الورشة موجودة ومنشورة (ووصل موعدها) والتسجيل فيها مفتوح
    function workshopOpenFor(wid) {
      let path = /databases/$(database)/documents/workshops/$(wid);
      return exists(path) && isOpenWorkshop(get(path).data);
    }
    function isOpenWorkshop(w) {
      return w.status == 'live' && w.open == true && published(w) && !dayOver(w);
    }
    // يوم الورشة خلص (date = YYYY-MM-DD): التسجيل بيتسكّر لحاله حتى لو ما حدا أرشفها
    function dayOver(w) {
      let d = w.get('date', '');
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time > timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) + duration.value(1, 'd');
    }

    // ---------- تسجيلات الورشات ----------
    // الزوار: إضافة تسجيل صالح بس، لورشة منشورة وتسجيلها مفتوح. الأدمن: قراءة، حذف، تعليم «حضر»، ربط الشهادة، وربط الورشة.
    // رقم الـ document نفسه هو كود الدخول (QR). الحضور بينحفظ مع وقته (attendedAt = وقت السيرفر) ومين سجّله
    // (attendedBy = إيميل المشرف نفسه)، وpassMailedAt / certMailedAt = متى انبعتت بطاقة الدخول / الشهادة بالإيميل.
    match /workshopRegs/{regId} {
      allow create: if isValidWorkshopReg(request.resource.data)
        && workshopOpenFor(request.resource.data.workshopId);
      allow read, delete: if can('workshops');
      allow update: if (can('workshops') && isValidRegUpdate(request.resource.data, request.resource.data.diff(resource.data).affectedKeys()))
        || isLiveSelfCheckin(regId);
    }

    // ---------- حضور الورشات الأونلاين (صفحة /live) ----------
    // اللي معه رمز دخول (رقم التسجيل) بيسجّل حضوره بنفسه يوم الورشة الأونلاين: بينعمل liveJoins/{regId}
    // (بس لتسجيل حقيقي بنفس الورشة) وبيتعلّم التسجيل «حضر» (attendedBy = 'live'). خدمة النشر بتقرأ liveJoins
    // وبعدها بس بتعطيه رابط زوم/ميت. liveKeys/{wid}_{أرقام الواتساب} = { id } بيكتبها الأدمن، عشان اللي
    // ما معه البطاقة يدخل برقم الواتساب.
    function liveOpenFor(wid) {
      let path = /databases/$(database)/documents/workshops/$(wid);
      let w = get(path).data;
      return w.get('mode', 'onsite') == 'online' && w.get('status', '') in ['live', 'done']
        && ((hasLiveTimes(w) && request.time >= w.liveFrom && request.time < w.liveTo)
          || (!hasLiveTimes(w) && liveDayOpen(w)));
    }
    // وقت الدخول اللي حدّده الأدمن (liveFrom / liveTo)، مثلاً 9:30 لـ 2:30
    function hasLiveTimes(w) {
      return w.get('liveFrom', null) is timestamp && w.get('liveTo', null) is timestamp;
    }
    // بدونه: يوم الورشة بتوقيت غزة (UTC+2/+3)، مع هامش: من 8 بالليل قبلها لـ 6 الصبح بعدها
    function liveDayOpen(w) {
      let p = w.get('date', '').split('-');
      return p.size() == 3
        && request.time >= timestamp.date(int(p[0]), int(p[1]), int(p[2])) - duration.value(6, 'h')
        && request.time < timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(28, 'h');
    }
    function isLiveSelfCheckin(regId) {
      let k = request.resource.data.diff(resource.data).affectedKeys();
      return k.hasOnly(['attended', 'attendedAt', 'attendedBy'])
        && resource.data.get('attended', false) != true
        && request.resource.data.attended == true
        && request.resource.data.attendedAt == request.time
        && request.resource.data.attendedBy == 'live'
        && existsAfter(/databases/$(database)/documents/liveJoins/$(regId))
        && liveOpenFor(resource.data.workshopId);
    }
    match /liveJoins/{regId} {
      allow get: if true;
      allow list, delete: if can('workshops');
      allow create: if request.resource.data.keys().hasOnly(['workshopId', 'at'])
        && request.resource.data.at == request.time
        && request.resource.data.workshopId is string
        && get(/databases/$(database)/documents/workshopRegs/$(regId)).data.workshopId == request.resource.data.workshopId
        && liveOpenFor(request.resource.data.workshopId);
    }
    match /liveKeys/{key} {
      allow get: if true;
      allow list, delete: if can('workshops');
      allow create, update: if can('workshops')
        && request.resource.data.keys().hasOnly(['id'])
        && isStr(request.resource.data.id, 12, 40)
        && key.matches('^[A-Za-z0-9_-]{1,40}_[0-9]{8,15}$');
    }
    function isValidRegUpdate(d, k) {
      return k.hasOnly(['attended', 'attendedAt', 'attendedBy', 'certId', 'workshopId', 'passMailedAt', 'certMailedAt'])
        && d.get('attended', false) is bool
        && d.get('certId', '') is string
        && d.get('workshopId', '') is string
        && (!k.hasAny(['attendedAt']) || !('attendedAt' in d) || d.attendedAt == request.time)
        && (!k.hasAny(['attendedBy']) || !('attendedBy' in d) || d.attendedBy == request.auth.token.email)
        && (!k.hasAny(['passMailedAt']) || d.get('passMailedAt', null) == request.time)
        && (!k.hasAny(['certMailedAt']) || d.get('certMailedAt', null) == request.time);
    }

    // ---------- ملاحظات الأدمن على الأشخاص (ملف العضو) ----------
    // person = مفتاح الشخص (رقم الواتساب أو الإيميل)، وكل ملاحظة doc لحالها باسم كاتبها ووقتها.
    // بتنقرأ وبتنكتب بصلاحية «التسجيلات» بس؛ كاتب الملاحظة (أو أدمن كامل) بيحذفها، وما بتتعدّل.
    match /memberNotes/{noteId} {
      allow read: if can('members');
      allow create: if can('members')
        && request.resource.data.keys().hasAll(['person', 'text', 'by', 'at'])
        && request.resource.data.keys().hasOnly(['person', 'text', 'name', 'by', 'at'])
        && isStr(request.resource.data.person, 3, 140)
        && isStr(request.resource.data.text, 1, 2000)
        && (!('name' in request.resource.data) || isStr(request.resource.data.name, 0, 80))
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.at == request.time;
      allow delete: if can('members') && (resource.data.by == request.auth.token.email || isFull());
    }

    function isValidWorkshopReg(d) {
      // الاسم والواتساب والموافقة دايماً؛ باقي الحقول حسب فورم الورشة (بتنفحص إذا انبعتت)
      return d.keys().hasAll(['workshopId', 'name', 'whatsapp', 'consent', 'createdAt'])
        && d.keys().hasOnly(['workshopId', 'name', 'whatsapp', 'email', 'major', 'status', 'level', 'laptop', 'aiTools',
                             'expectations', 'consent', 'source', 'createdAt'])
        && isStr(d.workshopId, 1, 40) && d.workshopId.matches('^[A-Za-z0-9_-]+$')
        && d.consent == true
        && isStr(d.name, 2, 80)
        && d.whatsapp is string && d.whatsapp.matches('^\\+[1-9][0-9]{7,14}$')
        && (!('email' in d) || (isStr(d.email, 6, 120) && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')))
        && (!('major' in d) || isStr(d.major, 1, 80))
        && (!('status' in d) || d.status in ['tawjihi', 'student', 'graduate', 'other'])
        && (!('level' in d) || d.level in ['beginner', 'intermediate', 'advanced'])
        && (!('laptop' in d) || d.laptop is bool)
        && (!('aiTools' in d) || (d.aiTools is list && d.aiTools.size() <= 6
            && d.aiTools.hasOnly(['chatgpt', 'claude', 'gemini', 'copilot', 'cursor', 'none'])))
        && (!('expectations' in d) || isStr(d.expectations, 0, 500))
        && (!('source' in d) || d.source == 'web')
        && d.createdAt == request.time;
    }

    // ---------- المدربين (فورم /trainer) ----------
    // الزوار: إضافة تسجيل صالح بس. الأدمن: قراءة وحذف.
    match /trainers/{tid} {
      allow create: if formOpen('trainerOpen') && isValidTrainer(request.resource.data);
      allow read, delete: if can('forms');
    }

    // site/forms (من تبويب «الفورمات»): surveyOpen / trainerOpen يفتحوا ويسكّروا الفورمات، و surveyKeys = مفاتيح المواضيع المسموحة
    function formOpen(flag) {
      let path = /databases/$(database)/documents/site/forms;
      return !exists(path) || get(path).data.get(flag, true) != false;
    }
    function surveyKeys() {
      let path = /databases/$(database)/documents/site/forms;
      return exists(path) && get(path).data.get('surveyKeys', null) is list ? get(path).data.surveyKeys
        : ['web', 'mobile', 'ai', 'data', 'security', 'uiux', 'graphic', 'video', 'programming',
           'database', 'network', 'freelance', 'english', 'career', 'soft', 'startup'];
    }

    function isValidTrainer(d) {
      return d.keys().hasAll(['name', 'whatsapp', 'specialty', 'age', 'years', 'mode', 'topic', 'consent', 'createdAt'])
        && d.keys().hasOnly(['name', 'whatsapp', 'email', 'specialty', 'age', 'years', 'mode', 'topic', 'venues',
                             'consent', 'source', 'createdAt'])
        && d.consent == true
        && isStr(d.name, 2, 80)
        && d.whatsapp is string && d.whatsapp.matches('^\\+[1-9][0-9]{7,14}$')
        && (!('email' in d) || (isStr(d.email, 6, 120) && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')))
        && isStr(d.specialty, 2, 80)
        && d.age is int && d.age >= 16 && d.age <= 80
        && d.years is int && d.years >= 0 && d.years <= 60
        && d.mode in ['workshop', 'course', 'both']
        && isStr(d.topic, 2, 300)
        && (!('venues' in d) || isStr(d.venues, 0, 500))
        && (!('source' in d) || d.source == 'web')
        && d.createdAt == request.time;
    }

    // ---------- استبيان المواضيع (فورم /survey) ----------
    // الاسم والرقم اختياريين؛ إذا انكتب واحد منهم لازم الموافقة. topics = مفاتيح المواضيع المسموحة (surveyKeys بـ site/forms، والقائمة الافتراضية لحد ما الأدمن يعدّل).
    match /topicSurveys/{sid} {
      allow create: if formOpen('surveyOpen') && isValidSurvey(request.resource.data);
      allow read, delete: if can('forms');
    }

    function isValidSurvey(d) {
      return d.keys().hasAll(['topics', 'format', 'createdAt'])
        && d.keys().hasOnly(['topics', 'other', 'format', 'status', 'name', 'whatsapp', 'consent', 'source', 'createdAt'])
        && d.topics is list && d.topics.size() <= 20
        && (d.topics.size() > 0 || ('other' in d && isStr(d.other, 2, 200)))
        && d.topics.hasOnly(surveyKeys())
        && (!('other' in d) || isStr(d.other, 1, 200))
        && d.format in ['workshop', 'course', 'any']
        && (!('status' in d) || d.status in ['tawjihi', 'student', 'graduate', 'other'])
        && (!('name' in d) || isStr(d.name, 2, 80))
        && (!('whatsapp' in d) || (d.whatsapp is string && d.whatsapp.matches('^\\+[1-9][0-9]{7,14}$')))
        && (!('consent' in d) || d.consent == true)
        && (!(('name' in d) || ('whatsapp' in d)) || ('consent' in d))
        && (!('source' in d) || d.source == 'web')
        && d.createdAt == request.time;
    }

    // ---------- الشهادات ----------
    // أي حدا معه الرابط (رقم الـ document العشوائي) بيقدر يفتح الشهادة؛ عرض القائمة والإصدار للأدمن بس.
    // workshopId = الورشة اللي انصدرت إلها (عنوانها وقالبها بيطلعوا على الشهادة).
    match /certificates/{certId} {
      allow get: if true;
      allow list: if can('workshops');
      allow create, update: if can('workshops')
        && request.resource.data.keys().hasOnly(['name', 'no', 'date', 'regId', 'workshopId', 'design', 'createdAt'])
        && isStr(request.resource.data.name, 2, 80)
        && isStr(request.resource.data.no, 1, 40)
        && isStr(request.resource.data.date, 0, 40)
        && (!('regId' in request.resource.data) || isStr(request.resource.data.regId, 0, 40))
        && (!('workshopId' in request.resource.data) || isStr(request.resource.data.workshopId, 1, 40))
        && (!('design' in request.resource.data) || request.resource.data.design.matches('^[a-f0-9]{32}$'));
      allow delete: if can('workshops');
    }

    // ---------- تصاميم الشهادات الصادرة ----------
    // نسخة ثابتة من التصميم اللي انصدرت فيه الشهادة (certificates/{id}.design): تعديل تصميم الورشة بعدين ما بيغيّرها.
    // الـ id هو hash المحتوى، فما بتنعدّل: تصميم جديد = مستند جديد.
    match /certDesigns/{designId} {
      allow get: if true;
      allow create: if can('workshops')
        && designId.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['wid', 'cert', 'title', 'titleAr', 'hours', 'createdAt'])
        && request.resource.data.cert is map
        && isStr(request.resource.data.wid, 1, 40);
    }

    // ---------- الفعاليات ----------
    // الزوار بيشوفوا المنشور بس؛ الأدمن بيشوف ويعدّل الكل.
    match /events/{eventId} {
      allow read: if resource.data.published == true || canSite('events');
      allow create, update: if canSite('events') && isValidEvent(request.resource.data);
      allow delete: if canSite('events');
    }

    function isValidEvent(d) {
      return d.keys().hasOnly(['type', 'title', 'date', 'place', 'description', 'link',
                               'published', 'createdAt', 'updatedAt'])
        && d.type in ['event', 'course', 'announcement']
        && isStr(d.title, 1, 120)
        && d.published is bool
        && (!('date' in d) || isStr(d.date, 0, 10))
        && (!('place' in d) || isStr(d.place, 0, 120))
        && (!('description' in d) || isStr(d.description, 0, 2000))
        && (!('link' in d) || (isStr(d.link, 0, 500) && (d.link == '' || d.link.matches('^https?://.+'))));
    }

    // ---------- أعضاء المجتمع (سكشن «الأعضاء» بالصفحة الرئيسية) ----------
    // ناس بيضيفهم الأدمن يدوياً؛ الزوار بيشوفوا المنشورين بس. ظهور السكشن نفسه بيتحكم فيه site/settings.showMembers.
    match /team/{memberId} {
      allow read: if resource.data.published == true || can('team');
      allow create, update: if can('team') && isValidTeamMember(request.resource.data);
      allow delete: if can('team');
    }

    function isValidTeamMember(d) {
      return d.keys().hasOnly(['name', 'nameEn', 'role', 'roleEn', 'bio', 'bioEn', 'link', 'facebook', 'instagram', 'linkedin', 'whatsapp', 'photo', 'order', 'published', 'createdAt', 'updatedAt'])
        && isStr(d.name, 1, 80)
        && d.published is bool
        && (!('role' in d) || isStr(d.role, 0, 80))
        && (!('bio' in d) || isStr(d.bio, 0, 200))
        && (!('link' in d) || (isStr(d.link, 0, 300) && (d.link == '' || d.link.matches('^https?://[^\\s]+$'))))
        && (!('nameEn' in d) || isStr(d.nameEn, 0, 80))
        && (!('roleEn' in d) || isStr(d.roleEn, 0, 80))
        && (!('bioEn' in d) || isStr(d.bioEn, 0, 200))
        && (!('facebook' in d) || (isStr(d.facebook, 0, 300) && (d.facebook == '' || d.facebook.matches('^https?://[^\\s]+$'))))
        && (!('instagram' in d) || (isStr(d.instagram, 0, 300) && (d.instagram == '' || d.instagram.matches('^https?://[^\\s]+$'))))
        && (!('linkedin' in d) || (isStr(d.linkedin, 0, 300) && (d.linkedin == '' || d.linkedin.matches('^https?://[^\\s]+$'))))
        && (!('whatsapp' in d) || (isStr(d.whatsapp, 0, 20) && (d.whatsapp == '' || d.whatsapp.matches('^\\+[1-9][0-9]{7,14}$'))))
        && (!('photo' in d) || d.photo == '' || (isStr(d.photo, 30, 90000) && d.photo.matches('^data:image/(jpeg|png|webp);base64,.*')))
        && (!('order' in d) || d.order is int);
    }

    // ---------- معرض الصور ----------
    // gallery: الصورة المصغّرة + الكابشن + الألبوم + وصف البوست (albumDesc، نفسه على كل صور الألبوم).
    // الزوار بيشوفوا المنشور بس. album فاضي = «صور متنوعة».
    match /gallery/{photoId} {
      allow read: if resource.data.published == true || canSite('gallery');
      allow create, update: if canSite('gallery')
        && request.resource.data.keys().hasOnly(['thumb', 'caption', 'album', 'albumDesc', 'published', 'order', 'w', 'h', 'createdAt', 'updatedAt'])
        && isStr(request.resource.data.thumb, 30, 120000)
        && request.resource.data.thumb.matches('^data:image/(jpeg|png|webp);base64,.*')
        && isStr(request.resource.data.caption, 0, 280)
        && (!('album' in request.resource.data) || isStr(request.resource.data.album, 0, 80))
        && (!('albumDesc' in request.resource.data) || isStr(request.resource.data.albumDesc, 0, 600))
        && request.resource.data.published is bool;
      allow delete: if canSite('gallery');
    }
    // galleryFull: الصورة بحجمها الكامل، بتنقرأ بس إذا الصورة منشورة
    match /galleryFull/{photoId} {
      allow get: if canSite('gallery')
        || get(/databases/$(database)/documents/gallery/$(photoId)).data.published == true;
      allow list: if canSite('gallery');
      allow create, update: if canSite('gallery')
        && request.resource.data.keys().hasOnly(['src'])
        && isStr(request.resource.data.src, 30, 950000)
        && request.resource.data.src.matches('^data:image/(jpeg|png|webp);base64,.*');
      allow delete: if canSite('gallery');
    }

    // ---------- المدونة ----------
    // blog: بطاقة المقال (العنوان، الرابط، الملخص، صورة صغيرة، الوسوم…) وهي اللي بتنعرض بالقوائم.
    // status: draft (للمشرفين بس) / published. publishAt (اختياري) = نشر مجدول: المقال بيضل مخفي لحد هالوقت.
    // القائمة بتنقرأ بشرط status == 'published' (الصفحة بتخفي المجدول لحد موعده)، والمقال نفسه ونصّه ما بينفتحوا قبل الموعد.
    function postLive(p) {
      return p.status == 'published' && published(p);
    }
    function postOf(id) {
      return get(/databases/$(database)/documents/blog/$(id)).data;
    }
    match /blog/{postId} {
      allow get: if can('blog') || postLive(resource.data);
      allow list: if can('blog') || resource.data.status == 'published';
      allow create, update: if can('blog') && isValidPost(request.resource.data);
      allow delete: if can('blog');
    }
    function isValidPost(d) {
      return d.keys().hasOnly(['title', 'slug', 'excerpt', 'cover', 'coverAlt', 'tags', 'author', 'date', 'status', 'publishAt',
                               'pinned', 'readMin', 'createdAt', 'updatedAt'])
        && isStr(d.title, 1, 140)
        && isStr(d.slug, 1, 90) && d.slug.matches('^[^\\s/?#%&]+$')
        && d.status in ['draft', 'published']
        && (!('excerpt' in d) || isStr(d.excerpt, 0, 320))
        && (!('cover' in d) || d.cover == '' || (isStr(d.cover, 30, 160000) && d.cover.matches('^data:image/(jpeg|png|webp);base64,.*')))
        && (!('coverAlt' in d) || isStr(d.coverAlt, 0, 140))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 8))
        && (!('author' in d) || isStr(d.author, 0, 80))
        && (!('date' in d) || isStr(d.date, 0, 10))
        && (!('publishAt' in d) || d.publishAt == null || d.publishAt is timestamp)
        && (!('pinned' in d) || d.pinned is bool)
        && (!('readMin' in d) || d.readMin is int);
    }
    // blogBody: نص المقال (Markdown) والغلاف بحجمه الكامل، بينقرأ بس إذا المقال نفسه منشور ووصل موعده
    match /blogBody/{postId} {
      allow get: if can('blog') || postLive(postOf(postId));
      allow list: if can('blog');
      allow create, update: if can('blog')
        && request.resource.data.keys().hasOnly(['md', 'cover'])
        && isStr(request.resource.data.md, 0, 300000)
        && (!('cover' in request.resource.data) || request.resource.data.cover == ''
            || (isStr(request.resource.data.cover, 30, 650000) && request.resource.data.cover.matches('^data:image/(jpeg|png|webp);base64,.*')));
      allow delete: if can('blog');
    }
    // blogMedia: الصور جوّا المقالات (كل صورة doc لحالها، post = رقم المقال)
    match /blogMedia/{mediaId} {
      allow get: if can('blog') || postLive(postOf(resource.data.post));
      allow list: if can('blog');
      allow create, update: if can('blog')
        && request.resource.data.keys().hasOnly(['src', 'post', 'w', 'h'])
        && isStr(request.resource.data.post, 1, 40)
        && isStr(request.resource.data.src, 30, 900000)
        && request.resource.data.src.matches('^data:image/(jpeg|png|webp);base64,.*');
      allow delete: if can('blog');
    }

    // ---------- الأدمنز والمشرفين ----------
    // كل مستخدم بيقدر يتأكد إذا هو أدمن (وشو صلاحياته). صاحب المنصة بيشوف الكل، وبيضيف ويعدّل ويشيل
    // (ما بيقدر يشيل حاله). المشرف المدعو (adminInvites) بيفعّل حسابه بنفسه بعد ما يأكّد إيميله.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow read: if isOwner();
      allow create: if (isOwner() && isValidAdmin(request.resource.data)) || claimsInvite(uid);
      allow update: if isOwner() && isValidAdmin(request.resource.data)
        && (resource.data.get('email', '') == '' || resource.data.email == request.resource.data.email);
      allow delete: if isOwner() && uid != request.auth.uid;
    }
    function isValidAdmin(d) {
      return d.keys().hasOnly(['email', 'name', 'perms', 'addedBy', 'createdAt', 'updatedAt'])
        && isStr(d.email, 0, 120)
        && (!('name' in d) || isStr(d.name, 0, 80))
        && d.perms is list && d.perms.size() <= 13 && d.perms.hasOnly(permKeys())
        && (!('addedBy' in d) || isStr(d.addedBy, 0, 120));
    }
    function inviteFor(email) {
      return /databases/$(database)/documents/adminInvites/$(email);
    }
    function claimsInvite(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && exists(inviteFor(request.auth.token.email))
        && isValidAdmin(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.perms == get(inviteFor(request.auth.token.email)).data.perms;
    }
    // دعوة لإيميل إله حساب من قبل (مثلاً من تطبيق ثاني بنفس المشروع)
    match /adminInvites/{email} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && isValidAdmin(request.resource.data) && request.resource.data.email == email;
      allow get: if request.auth != null && request.auth.token.email == email;
      allow delete: if request.auth != null && request.auth.token.email == email
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------- نشاط المشرفين (صاحب المنصة بس بيشوفه) ----------
    // كل أدمن بيضيف أسطر باسمه هو بس (دخل / عمل شي)، وما بيقدر يعدّلها أو يحذفها.
    match /adminLog/{id} {
      allow read, delete: if isOwner();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'type', 'text', 'tab', 'device', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.type in ['login', 'action']
        && isStr(request.resource.data.text, 1, 200)
        && (!('tab' in request.resource.data) || isStr(request.resource.data.tab, 0, 30))
        && (!('device' in request.resource.data) || isStr(request.resource.data.device, 0, 60))
        && request.resource.data.at == request.time;
    }
    // سطر واحد لكل أدمن: آخر دخول، آخر ظهور، آخر شي عمله
    match /adminSeen/{uid} {
      allow read, delete: if isOwner();
      allow create, update: if isAdmin() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'loginAt', 'seenAt', 'lastText', 'lastAt', 'tab', 'device'])
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.seenAt == request.time
        && sameOrNow('loginAt') && sameOrNow('lastAt')
        && (!('lastText' in request.resource.data) || isStr(request.resource.data.lastText, 0, 200))
        && (!('tab' in request.resource.data) || isStr(request.resource.data.tab, 0, 30))
        && (!('device' in request.resource.data) || isStr(request.resource.data.device, 0, 60));
    }
    // a time field is either kept as it was or set to now (no back-dating)
    function sameOrNow(f) {
      return !(f in request.resource.data) || request.resource.data[f] == request.time
        || (resource != null && f in resource.data && request.resource.data[f] == resource.data[f]);
    }

    // ---------- قوالب استوديو السوشيال (لوحة الإدارة) ----------
    // التصميم نفسه JSON نصّي (عناصر + صور مضغوطة)، والأدمن بس بيقرأ وبيكتب.
    match /socialTemplates/{id} {
      allow read, delete: if can('studio');
      allow create, update: if can('studio')
        && request.resource.data.keys().hasOnly(['name', 'design', 'updatedAt', 'updatedBy'])
        && isStr(request.resource.data.name, 1, 60)
        && request.resource.data.design is string
        && request.resource.data.design.size() < 1000000
        && request.resource.data.updatedAt == request.time
        && (!('updatedBy' in request.resource.data) || isStr(request.resource.data.updatedBy, 0, 120));
    }

    // أي مسار ثاني مقفول
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
