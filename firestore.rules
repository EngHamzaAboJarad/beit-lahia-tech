rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // الأدمن = مستخدم مسجّل دخول وإله document باسم الـ UID تبعه في admins (بينضاف من الكونسول بس)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function registrationOpen() {
      let path = /databases/$(database)/documents/site/settings;
      return !exists(path) || get(path).data.get('registrationOpen', true) != false;
    }

    // ---------- التسجيلات ----------
    // الزوار: إضافة تسجيل صالح بس (ولما يكون التسجيل مفتوح).
    // الأدمن: قراءة، حذف، تعليم «تواصلنا»، ونقل لسلة المحذوفات (deletedAt) أو استرجاع منها.
    match /members/{memberId} {
      allow create: if registrationOpen() && isValidMember(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacted', 'deletedAt'])
        && request.resource.data.get('contacted', false) is bool
        && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == request.time);
    }

    // ---------- عدّاد الزيارات ----------
    // stats/{YYYY-MM-DD}: أرقام بس (home / join / start). الزائر بيقدر يزيد رقم واحد بـ 1 كل مرة، والأدمن بس بيقرأ.
    match /stats/{day} {
      allow read: if isAdmin();
      allow create: if day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && request.resource.data.keys().hasOnly(['home', 'join', 'start'])
        && request.resource.data.size() == 1
        && request.resource.data.get('home', 1) == 1
        && request.resource.data.get('join', 1) == 1
        && request.resource.data.get('start', 1) == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['home', 'join', 'start'])
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && bumped('home') && bumped('join') && bumped('start');
    }

    function bumped(k) {
      return request.resource.data.get(k, 0) == resource.data.get(k, 0)
        || request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1;
    }

    function isValidMember(d) {
      return d.keys().hasAll(['name', 'whatsapp', 'status', 'specialty', 'age', 'residence', 'consent', 'createdAt'])
        && d.keys().hasOnly(['name', 'whatsapp', 'email', 'status', 'specialty', 'age', 'experience',
                             'residence', 'university', 'portfolio', 'notes', 'consent', 'source', 'createdAt'])
        && d.consent == true
        && d.whatsapp is string && d.whatsapp.matches('^\\+[1-9][0-9]{7,14}$')
        && (!('email' in d) || (isStr(d.email, 6, 120) && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')))
        && (!('portfolio' in d) || (isStr(d.portfolio, 10, 300) && d.portfolio.matches('^https?://[^\\s]+$')))
        && isStr(d.name, 2, 80)
        && d.status in ['tawjihi', 'student', 'graduate']
        // طالب التوجيهي ما إله جامعة ولا خبرة؛ الباقي لازم يبعتوهم
        && (d.status == 'tawjihi' || d.keys().hasAll(['experience', 'university']))
        && isStr(d.specialty, 2, 80)
        && d.age is int && d.age >= 14 && d.age <= 70
        && (!('experience' in d) || d.experience in ['none', 'lt1', '1-2', '3-5', '5+'])
        && isStr(d.residence, 2, 80)
        && (!('university' in d) || isStr(d.university, 2, 120))
        && (!('notes' in d) || isStr(d.notes, 0, 1000))
        && (!('source' in d) || d.source == 'web')
        && d.createdAt == request.time;
    }

    // ---------- محتوى الصفحة والإعدادات ----------
    // settings.currentWorkshop = رقم الورشة اللي بتطلع على /workshop
    match /site/{docId} {
      allow read: if docId in ['content', 'settings'];
      allow write: if isAdmin() && docId in ['content', 'settings']
        && request.resource.size() < 200 * 1024;
    }

    // ---------- الورشات ----------
    // كل ورشة doc لحالها: المعلومات + المحاور + قالب الشهادة. status: draft (للأدمن بس) / live (منشورة) / done (انتهت، بالأرشيف).
    // publishAt (اختياري): ورشة «منشورة» بتضل مخفية وما بتقبل تسجيل لحد هاد الوقت (نشر مجدول).
    match /workshops/{wid} {
      allow read: if isAdmin() || resource.data.status == 'done'
        || (resource.data.status == 'live' && published(resource.data));
      allow create, update: if isAdmin()
        && request.resource.data.status in ['draft', 'live', 'done']
        && request.resource.data.open is bool
        && isStr(request.resource.data.title, 1, 60)
        && (request.resource.data.get('publishAt', null) == null || request.resource.data.publishAt is timestamp)
        && request.resource.size() < 400 * 1024;
      allow delete: if isAdmin();
    }

    // وصل موعد نشرها (أو ما إلها موعد)
    function published(w) {
      return w.get('publishAt', null) == null || request.time >= w.publishAt;
    }

    // الورشة موجودة ومنشورة (ووصل موعدها) والتسجيل فيها مفتوح
    function workshopOpenFor(wid) {
      let path = /databases/$(database)/documents/workshops/$(wid);
      return exists(path) && isOpenWorkshop(get(path).data);
    }
    function isOpenWorkshop(w) {
      return w.status == 'live' && w.open == true && published(w);
    }

    // ---------- تسجيلات الورشات ----------
    // الزوار: إضافة تسجيل صالح بس، لورشة منشورة وتسجيلها مفتوح. الأدمن: قراءة، حذف، تعليم «حضر»، ربط الشهادة، وربط الورشة.
    match /workshopRegs/{regId} {
      allow create: if isValidWorkshopReg(request.resource.data)
        && workshopOpenFor(request.resource.data.workshopId);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attended', 'certId', 'workshopId'])
        && request.resource.data.get('attended', false) is bool
        && request.resource.data.get('certId', '') is string
        && request.resource.data.get('workshopId', '') is string;
    }

    function isValidWorkshopReg(d) {
      // الاسم والواتساب والموافقة دايماً؛ باقي الحقول حسب فورم الورشة (بتنفحص إذا انبعتت)
      return d.keys().hasAll(['workshopId', 'name', 'whatsapp', 'consent', 'createdAt'])
        && d.keys().hasOnly(['workshopId', 'name', 'whatsapp', 'email', 'status', 'level', 'laptop', 'aiTools',
                             'expectations', 'consent', 'source', 'createdAt'])
        && isStr(d.workshopId, 1, 40) && d.workshopId.matches('^[A-Za-z0-9_-]+$')
        && d.consent == true
        && isStr(d.name, 2, 80)
        && d.whatsapp is string && d.whatsapp.matches('^\\+[1-9][0-9]{7,14}$')
        && (!('email' in d) || (isStr(d.email, 6, 120) && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')))
        && (!('status' in d) || d.status in ['tawjihi', 'student', 'graduate', 'other'])
        && (!('level' in d) || d.level in ['beginner', 'intermediate', 'advanced'])
        && (!('laptop' in d) || d.laptop is bool)
        && (!('aiTools' in d) || (d.aiTools is list && d.aiTools.size() <= 6
            && d.aiTools.hasOnly(['chatgpt', 'claude', 'gemini', 'copilot', 'cursor', 'none'])))
        && (!('expectations' in d) || isStr(d.expectations, 0, 500))
        && (!('source' in d) || d.source == 'web')
        && d.createdAt == request.time;
    }

    // ---------- الشهادات ----------
    // أي حدا معه الرابط (رقم الـ document العشوائي) بيقدر يفتح الشهادة؛ عرض القائمة والإصدار للأدمن بس.
    // workshopId = الورشة اللي انصدرت إلها (عنوانها وقالبها بيطلعوا على الشهادة).
    match /certificates/{certId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'no', 'date', 'regId', 'workshopId', 'createdAt'])
        && isStr(request.resource.data.name, 2, 80)
        && isStr(request.resource.data.no, 1, 40)
        && isStr(request.resource.data.date, 0, 40)
        && (!('regId' in request.resource.data) || isStr(request.resource.data.regId, 0, 40))
        && (!('workshopId' in request.resource.data) || isStr(request.resource.data.workshopId, 1, 40));
      allow delete: if isAdmin();
    }

    // ---------- الفعاليات ----------
    // الزوار بيشوفوا المنشور بس؛ الأدمن بيشوف ويعدّل الكل.
    match /events/{eventId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isValidEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    function isValidEvent(d) {
      return d.keys().hasOnly(['type', 'title', 'date', 'place', 'description', 'link',
                               'published', 'createdAt', 'updatedAt'])
        && d.type in ['event', 'course', 'announcement']
        && isStr(d.title, 1, 120)
        && d.published is bool
        && (!('date' in d) || isStr(d.date, 0, 10))
        && (!('place' in d) || isStr(d.place, 0, 120))
        && (!('description' in d) || isStr(d.description, 0, 2000))
        && (!('link' in d) || (isStr(d.link, 0, 500) && (d.link == '' || d.link.matches('^https?://.+'))));
    }

    // ---------- أعضاء المجتمع (سكشن «الأعضاء» بالصفحة الرئيسية) ----------
    // ناس بيضيفهم الأدمن يدوياً؛ الزوار بيشوفوا المنشورين بس. ظهور السكشن نفسه بيتحكم فيه site/settings.showMembers.
    match /team/{memberId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isValidTeamMember(request.resource.data);
      allow delete: if isAdmin();
    }

    function isValidTeamMember(d) {
      return d.keys().hasOnly(['name', 'role', 'bio', 'link', 'photo', 'order', 'published', 'createdAt', 'updatedAt'])
        && isStr(d.name, 1, 80)
        && d.published is bool
        && (!('role' in d) || isStr(d.role, 0, 80))
        && (!('bio' in d) || isStr(d.bio, 0, 200))
        && (!('link' in d) || (isStr(d.link, 0, 300) && (d.link == '' || d.link.matches('^https?://[^\\s]+$'))))
        && (!('photo' in d) || d.photo == '' || (isStr(d.photo, 30, 90000) && d.photo.matches('^data:image/(jpeg|png|webp);base64,.*')))
        && (!('order' in d) || d.order is int);
    }

    // ---------- معرض الصور ----------
    // gallery: الصورة المصغّرة + الوصف (الزوار بيشوفوا المنشور بس)
    match /gallery/{photoId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['thumb', 'caption', 'published', 'order', 'w', 'h', 'createdAt', 'updatedAt'])
        && isStr(request.resource.data.thumb, 30, 120000)
        && request.resource.data.thumb.matches('^data:image/(jpeg|png|webp);base64,.*')
        && isStr(request.resource.data.caption, 0, 140)
        && request.resource.data.published is bool;
      allow delete: if isAdmin();
    }
    // galleryFull: الصورة بحجمها الكامل، بتنقرأ بس إذا الصورة منشورة
    match /galleryFull/{photoId} {
      allow get: if isAdmin()
        || get(/databases/$(database)/documents/gallery/$(photoId)).data.published == true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['src'])
        && isStr(request.resource.data.src, 30, 950000)
        && request.resource.data.src.matches('^data:image/(jpeg|png|webp);base64,.*');
      allow delete: if isAdmin();
    }

    // ---------- الأدمنز ----------
    // كل مستخدم بيقدر يتأكد إذا هو أدمن؛ الإضافة والحذف من الكونسول فقط.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // أي مسار ثاني مقفول
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
